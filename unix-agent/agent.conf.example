{
  "_comment": "pg_arca Enterprise Node Configuration Template (/etc/pg-arca/agent.conf)",

  "node_name": "pg-node-01",
  "cluster_id": "cluster-prod-01",
  "environment": "prod",

  "connection_mode": "hybrid",
  "listen_host": "0.0.0.0",
  "listen_port": 9898,
  "socket_path": "/var/run/pg-arca/agent.sock",

  "auth_mode": "token",
  "auth_token": "arca-secret-production-token-98f2b7a4",
  "basic_auth_user": "arca_admin",
  "basic_auth_password": "",

  "web_server_url": "http://10.0.1.5:3000",
  "heartbeat_interval_seconds": 10,
  "auto_register": true,

  "pg_user": "postgres",
  "pg_port": 5432,
  "pg_host": "127.0.0.1",
  "pg_data": "/var/lib/postgresql/16/main",
  "patroni_url": "http://127.0.0.1:8008",

  "repo_path": "/var/lib/pgarca/repo",
  "wal_archive_dir": "/var/lib/postgresql/wal_archive",
  "scratch_dir": "/var/tmp/pg_arca_scratch",
  "safety_snapshot_dir": "/var/lib/pgarca/safety_snapshots",

  "compression": "zstd",
  "compression_level": 3,
  "chunk_size_bytes": 65536,

  "safety_require_admin_confirmation_for_inplace": true,
  "safety_enforce_preflight_amcheck": true,
  "safety_max_scratch_disk_usage_percent": 90
}
